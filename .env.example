# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- Django ---
# 1 = local development. Leave unset (or 0) in production.
DEBUG=1
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Comma-separated. On Render the service hostname is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Toronto

# Shown on the /privacy/ page as the address for questions and deletion requests.
CONTACT_EMAIL=

# --- Database ---
# Leave empty to use a local SQLite file.
# Production: the Supabase *session pooler* URI (Project → Connect → Session pooler).
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Google sign-in (optional locally) ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email reminders (milestone 5) ---
# Only needed where reminder emails are sent: GitHub Actions, or locally to test.
# Never set these on Render: its free tier blocks outgoing email, so sends would hang.
# Leave empty locally to print emails to the terminal instead of sending them.
SMTP_USERNAME=
SMTP_PASSWORD=
# Full address of the site, used for links inside emails.
SITE_URL=http://localhost:8000
